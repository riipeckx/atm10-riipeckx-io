[Unit]
Description=atm10.riipeckx.io Minecraft server
After=network.target

[Service]
User=root
Nice=1
KillMode=mixed
SuccessExitStatus=0 1
WorkingDirectory=/opt/atm10-riipeckx-io
ExecStart=/usr/bin/java @user_jvm_args.txt @libraries/net/neoforged/neoforge/21.1.194/unix_args.txt nogui "$@"
ExecStop=/usr/bin/mcrcon -P 25575 -p localhost -w 30 "say Server will stop in 30secs!" save-all stop

[Install]
WantedBy=multi-user.target