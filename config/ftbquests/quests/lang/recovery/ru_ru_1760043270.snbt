	"chapters/powah.snbt": {
		quest.61A8FAEC4FF18449.quest_desc: {
			new: ["Они могут быть использованы для зарядки предметов в вашем инвентаре или для увеличения общей мощности передачи данных &7эндер-сети&r."]
