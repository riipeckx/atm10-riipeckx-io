	"chapters/generators.snbt": {
		quest.07753C5D94312A50.quest_desc: {
			new: [
				"&3Дополнение&r: генератор — противоположность &3дополнение&r: фабрика. Вместо использования энергии для переплавки, оно переплавляет для производства энергии. Вы больше не будете переплавлять предметы, каждое топливо будет превращаться в энергию!"
				""
				"(Интересно, лучше ли соединить генератор и фабричные печи, чем просто использовать топливо в одной?)"
			]
			old: [
				"&3Улучшение&r: генератор — противоположность &3улучшения&r: фабрика. Вместо использования энергии для переплавки, оно переплавляет для производства энергии. Вы больше не будете переплавлять предметы, каждое топливо будет превращаться в энергию!"
				""
				"(Интересно, лучше ли соединить генератор и фабричные печи, чем просто использовать топливо в одной?)"
			]
		}
		quest.07753C5D94312A50.title: {
			new: "&3Дополнение&r: генератор"
			old: "&3Улучшение&r: генератор"
		}
		quest.538821E23E39BE97.title: {
			new: "&2Дополнение&r: эффективность топлива"
			old: "&2Улучшение&r: топливная эффективность"
		}
		quest.78D1C97A542133D8.quest_desc: {
			new: [
				"Дополнения — это апгрейды для печей из Iron Furnaces!"
				""
				"В правом верхнем углу интерфейса печи есть кнопка для просмотра раздела дополнений. Там будут красное, зелёное и синее места, каждое из которых может содержать 1 дополнение соответствующего цвета."
			]
			old: [
				"Улучшения — это апгрейды для печей из Iron Furnaces!"
				""
				"В правом верхнем углу интерфейса печи есть кнопка для просмотра раздела улучшений. Там будут красное, зелёное и синее места, каждое из которых может содержать 1 улучшение соответствующего цвета."
			]
		}
		quest.49F08DE190AAD0D8.title: {
			new: "&3Дополнение&r: фабрика"
			old: "&3Улучшение&r: фабрика"
		}
		quest.78D1C97A542133D8.title: {
			new: "&aДополнения"
			old: "&aУлучшения"
		}
		quest.73FF01D830A669AA.title: {
			new: "&4Дополнение&r: плавка"
			old: "&4Улучшение&r: плавка"
		}
		quest.73FF01D830A669AA.quest_desc: {
			new: ["&4Дополнение&r: плавка превращает вашу железную печь в железную плавильню! Теперь она будет переплавлять только руды, но в два раза быстрее! Да, это сочетается с эффектами других дополнений и разными уровнями печей."]
			old: ["&4Улучшение&r: плавка превращает вашу железную печь в железную плавильню! Теперь она будет переплавлять только руды, но в два раза быстрее! Да, это сочетается с эффектами других улучшений и разными уровнями печей."]
		}
		quest.33436ED0D9F128BD.quest_desc: {
			new: ["&4Дополнение&r: копчение превращает вашу железную печь в железную коптильню. Теперь она будет коптить только еду, но в два раза быстрее! Как и &4дополнение&r: плавка, это сочетается с другими дополнениями!"]
			old: ["&4Улучшение&r: копчение превращает вашу железную печь в железную коптильню. Теперь она будет коптить только еду, но в два раза быстрее! Как и &4улучшение&r: плавка, это сочетается с другими апгрейдами!"]
		}
		quest.49F08DE190AAD0D8.quest_desc: {
			new: ["&3Дополнение&r: фабрика делает вашу печь похожей на плавящий механизм из Mekanism. Вместо топлива она теперь использует энергию! Подайте энергию, и она начнёт переплавлять."]
			old: ["&3Улучшение&r: фабрика делает вашу печь похожей на плавящий механизм из Mekanism. Вместо топлива она теперь использует энергию! Подайте энергию, и она начнёт переплавлять."]
		}
		quest.538821E23E39BE97.quest_desc: {
			new: ["&2Дополнение&r: эффективность топлива для всех любителей Земли, обнимателей деревьев и поклонников Капитана Планеты. Печь потребляет половину топлива за счёт удвоенного времени. Уголь будет переплавлять не 8 предметов, а 16!"]
			old: ["&2Улучшение&r: топливная эффективность для всех любителей Земли, обнимателей деревьев и поклонников Капитана Планеты. Печь потребляет половину топлива за счёт удвоенного времени. Уголь будет переплавлять не 8 предметов, а 16!"]
		}
		quest.7F67849DE9F700D8.title: {
			new: "&2Дополнение&r: скорость"
			old: "&2Улучшение&r: скорость"
		}
		quest.7F67849DE9F700D8.quest_desc: {
			new: ["&2Дополнение&r: скорость делает вашу печь быстрее! &bАлмазная печь&r будет переплавлять каждые 40 тиков вместо 80 тиков. За счёт удвоенного потребления топлива."]
			old: ["&2Улучшение&r: скорость делает вашу печь быстрее! &bАлмазная печь&r будет переплавлять каждые 40 тиков вместо 80 тиков. За счёт удвоенного потребления топлива."]
		}
		quest.33436ED0D9F128BD.title: {
			new: "&4Дополнение&r: копчение"
			old: "&4Улучшение&r: копчение"
		}
	}
}
