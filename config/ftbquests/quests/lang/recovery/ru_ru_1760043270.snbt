			]
		}
		quest.5BD5737703F3F077.quest_desc: {
			new: ["Феррокор — новый материал, добавленный в JDT. Феррокор добывается путём распространения слизи на железных блоках с использованием слизи первого уровня или выше. Количество добытого феррокора зависит от удачи."]
			old: ["Феррикор — новый материал, добавленный в JDT. Феррикор добывается путём распространения слизи на железных блоках с использованием слизи первого уровня или выше. Количество добытого феррикора зависит от удачи."]
