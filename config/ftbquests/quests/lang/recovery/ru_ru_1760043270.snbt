		quest.079A415488A32076.quest_desc: {
			new: ["Пламенный уголь — новый материал, добавленный в JDT. Уголь пламени добывается путём распространения слизи на блоках первобытного угля с использованием слизи второго уровня или выше. Количество добытого угля пламени зависит от удачи."]
			old: ["Уголь пламени — новый материал, добавленный в JDT. Уголь пламени добывается путём распространения слизи на блоках первобытного угля с использованием слизи второго уровня или выше. Количество добытого угля пламени зависит от удачи."]
