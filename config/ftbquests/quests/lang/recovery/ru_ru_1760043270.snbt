	"chapters/justdirethings.snbt": {
		quest.446A37C7FCDACF84.quest_desc: {
			new: ["Уголь пламени пустоты — новый материал, добавленный в JDT. Пламя пустоты добывается путём распространения слизи на блоках углей пламени с использованием слизи третьего уровня или выше. Количество добытого угля пламени пустоты зависит от удачи."]
			old: ["Уголь пустопламени — новый материал, добавленный в JDT. Пустопламя добывается путём распространения слизи на блоках углей пламени с использованием слизи третьего уровня или выше. Количество добытого угля пустопламени зависит от удачи."]
		}
		quest.60A4994078500F63.title: {
			new: "Селестигем"
			old: "Небесный самоцвет"
		}
		quest.5C6709350BEF4050.quest_desc: {
			new: [
				"Пустомерцающая слизь — это третий уровень слизи, добавленный в JDT. Для её создания требуются материалы из Энда."
				""
				"Открываемые крафты:"
				"- селестигем"
				"- уголь пламени пустоты"
			]
			old: [
				"Слизь пустошиммера — это третий уровень слизи, добавленный в JDT. Для её создания требуются материалы из Энда."
				""
				"Открываемые крафты:"
				"- небесный самоцвет"
				"- пустопламя"
			]
		}
		quest.3D9964CB0440DD5A.quest_desc: {
			new: ["Бросание пламенного угля в полиморфную жидкость создаёт неочищенное топливо из пламенного угля. Проведение распространения слизи с использованием слизи второго уровня или выше превратит неочищенное топливо в топливо пламенного угля."]
			old: ["Бросание угля пламени в полиморфную жидкость создаёт неочищенное топливо угля пламени. Проведение распространения слизи с использованием слизи второго уровня или выше превратит неочищенное топливо угля пламени в топливо угля пламени."]
		}
		quest.60A4994078500F63.quest_desc: {
			new: ["Селестигем — новый материал, добавленный в JDT. Селестигем добывается путём распространения слизи на алмазных блоках с использованием слизи третьего уровня или выше. Количество добытых селестигемов зависит от удачи."]
			old: ["Небесный самоцвет — новый материал, добавленный в JDT. Небесный самоцвет добывается путём распространения слизи на алмазных блоках с использованием слизи третьего уровня или выше. Количество добытого небесного самоцвета зависит от удачи."]
		}
		quest.446A37C7FCDACF84.title: {
			new: "Уголь пламени пустоты"
			old: "Уголь пустопламени"
		}
		quest.05D8C6EF8FCD6250.title: {
			new: "Первородная слизь"
			old: "Слизь примогеля"
		}
		quest.4C54BD57CAB8A54B.quest_desc: {
			new: [
				"Пламецветная слизь — это второй уровень слизи, добавленный в JDT. Для её создания требуются материалы из Незера."
				""
				"Открываемые крафты:"
				"- пламезолото"
				"- пламенный уголь"
			]
			old: [
				"Слизь пламеквета — это второй уровень слизи, добавленный в JDT. Для её создания требуются материалы из Незера."
				""
				"Открываемые крафты:"
				"- пламезолото"
				"- уголь пламени"
			]
		}
		quest.49EF8A4346AEF582.quest_desc: {
			new: ["Бросание угля затмения в топливо пламени пустоты создаёт неочищенное топливо из угля затмения. Проведение распространения слизи с использованием слизи четвёртого уровня превратит неочищенное топливо в топливо из угля затмения."]
			old: ["Бросание угля затмения в топливо пустопламени создаёт неочищенное топливо угля затмения. Проведение распространения слизи с использованием слизи четвёртого уровня превратит неочищенное топливо угля затмения в топливо угля затмения."]
		}
		quest.70BF85E2D235BAD5.title: {
			new: "Ведро топлива пламенной пустоты"
			old: "Ведро топлива пустопламени"
		}
		quest.70BF85E2D235BAD5.quest_desc: {
			new: ["Бросание угля пламени пустоты в топливо из пламенного угля создаёт неочищенное топливо пламенной пустоты. Проведение распространения слизи с использованием слизи третьего уровня или выше превратит неочищенное топливо в топливо пламенной пустоты."]
			old: ["Бросание угля пустопламени в топливо угля пламени создаёт неочищенное топливо пустопламени. Проведение распространения слизи с использованием слизи третьего уровня или выше превратит неочищенное топливо пустопламени в топливо пустопламени."]
		}
		quest.3D9964CB0440DD5A.title: {
